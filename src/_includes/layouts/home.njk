        <div class="related-card__arrow">→</div>
      </a>
      <a class="related-card" href="{{ site.url }}/core-emergency-gis-architecture-data-standards/flatgeobuf-vs-geopackage-for-offline-caching/">
        <div class="related-card__label">Architecture &amp; Standards</div>
        <div class="related-card__title">FlatGeobuf vs GeoPackage for Offline Caching</div>
