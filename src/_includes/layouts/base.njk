{# Compute page metadata primitives once, reuse below #}
{% set _title = pageTitle or site.title %}
{% set _fullTitle = pageTitle and (pageTitle + " · " + site.name) or site.title %}
{% set _desc = pageDescription or site.description %}
{% set _path = page.url or "/" %}
{% set _canonical = site.url + _path %}
{% set _ogImage = (pageOgImage or site.ogImage) %}
{% set _ogImageAbs = site.url + _ogImage %}
{% set _pageType = pageType or "standard" %}
{% set _isHome = _path == "/" %}
{# Depth: 0 = home, 1 = section, 2+ = leaf article.
   Nunjucks `trim` only strips whitespace, so we count slashes instead:
   "/x/" → 2 slashes → depth 1, "/x/y/" → 3 slashes → depth 2, etc. #}
{% set _slashes = (_path | replace('/', '|/') | length) - (_path | length) %}
{% set _depth = _slashes - 1 %}
{% if _isHome %}{% set _depth = 0 %}{% endif %}
<!doctype html>
<html lang="{{ site.language }}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {# Resolve the theme BEFORE the stylesheet paints, so a dark-mode reader
       never gets a white flash. A stored choice wins; otherwise follow the OS.
       Writing the attribute in both cases means CSS only has to reason about
       an explicit [data-theme], and the prefers-color-scheme fallback in the
       stylesheet only ever matters when JS is off. #}
    <script>
      (function () {
        try {
          var stored = localStorage.getItem("igis-theme");
          var theme = stored === "dark" || stored === "light"
            ? stored
            : (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {}
      })();
    </script>
    <title>{{ _fullTitle }}</title>
    <meta name="description" content="{{ _desc }}" />
    <meta name="author" content="{{ site.author }}" />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="googlebot" content="index,follow,max-image-preview:large,max-snippet:-1" />
    <meta name="generator" content="Eleventy" />
    <meta name="theme-color" content="{{ site.themeColor }}" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="{{ site.themeColorDark }}" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href="{{ _canonical }}" />

    {# Favicons (covers legacy ICO, modern SVG, and PNG fallbacks) #}
    <link rel="icon" type="image/svg+xml" href="/assets/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/icons/icon-512.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="mask-icon" href="/assets/icons/favicon.svg" color="{{ site.themeColor }}" />

    {# PWA #}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="{{ site.name }}" />
    <meta name="application-name" content="{{ site.name }}" />

    {# Open Graph #}
    <meta property="og:type" content="{% if _depth >= 2 %}article{% else %}website{% endif %}" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="{{ site.locale }}" />
    <meta property="og:title" content="{{ _title }}" />
    <meta property="og:description" content="{{ _desc }}" />
    <meta property="og:url" content="{{ _canonical }}" />
    <meta property="og:image" content="{{ _ogImageAbs }}" />
    <meta property="og:image:secure_url" content="{{ _ogImageAbs }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ pageOgImageAlt or site.ogImageAlt }}" />

    {# Twitter Card #}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ _title }}" />
    <meta name="twitter:description" content="{{ _desc }}" />
    <meta name="twitter:image" content="{{ _ogImageAbs }}" />
    <meta name="twitter:image:alt" content="{{ pageOgImageAlt or site.ogImageAlt }}" />

    {# Sitemap discovery #}
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <link rel="stylesheet" href="/assets/css/styles.css?v={{ assets.styles }}" />

    {# Structured data (JSON-LD) #}
    {% if _isHome %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "{{ site.url }}/#organization",
          "name": "{{ site.name }}",
          "url": "{{ site.url }}/",
          "logo": {
            "@type": "ImageObject",
            "url": "{{ site.url }}/assets/icons/icon-512.png",
            "width": 512,
            "height": 512
          },
          "description": "{{ site.description }}"
        },
        {
          "@type": "WebSite",
          "@id": "{{ site.url }}/#website",
          "url": "{{ site.url }}/",
          "name": "{{ site.name }}",
          "description": "{{ site.description }}",
          "publisher": { "@id": "{{ site.url }}/#organization" },
          "inLanguage": "{{ site.language }}"
        }
      ]
    }
    </script>
    {% elif _depth == 1 %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": "{{ _canonical }}#collection",
      "url": "{{ _canonical }}",
      "name": "{{ _title }}",
      "description": "{{ _desc }}",
      "isPartOf": { "@type": "WebSite", "@id": "{{ site.url }}/#website", "url": "{{ site.url }}/", "name": "{{ site.name }}" },
      "inLanguage": "{{ site.language }}",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {% set _crumbs = _path | breadcrumbs(_title) %}
          {% for c in _crumbs %}{ "@type": "ListItem", "position": {{ loop.index }}, "name": {{ c.label | dump | safe }}, "item": "{{ site.url }}{{ c.url }}" }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }
    }
    </script>
    {% else %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "@id": "{{ _canonical }}#article",
      "headline": {{ _title | dump | safe }},
      "description": {{ _desc | dump | safe }},
      "url": "{{ _canonical }}",
      "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ _canonical }}" },
      "isPartOf": { "@type": "WebSite", "@id": "{{ site.url }}/#website", "url": "{{ site.url }}/", "name": "{{ site.name }}" },
      "inLanguage": "{{ site.language }}",
      "image": {
        "@type": "ImageObject",
        "url": "{{ _ogImageAbs }}",
        "width": 1200,
        "height": 630
      },
      "author": { "@type": "Organization", "name": "{{ site.author }}", "url": "{{ site.url }}/" },
      "publisher": {
        "@type": "Organization",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}/",
        "logo": {
          "@type": "ImageObject",
          "url": "{{ site.url }}/assets/icons/icon-512.png",
          "width": 512,
          "height": 512
        }
      },
      "datePublished": "{{ site.founded }}",
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {% set _crumbs = _path | breadcrumbs(_title) %}
          {% for c in _crumbs %}{ "@type": "ListItem", "position": {{ loop.index }}, "name": {{ c.label | dump | safe }}, "item": "{{ site.url }}{{ c.url }}" }{% if not loop.last %},{% endif %}{% endfor %}
        ]
      }
    }
    </script>
    {% endif %}
  </head>
  <body class="page-{{ _pageType }}">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header" role="banner">
      <div class="site-header__inner">
        <a href="{{ site.url }}/" class="site-brand" aria-label="{{ site.name }} home">
          <img src="/assets/icons/logo.svg" alt="{{ site.name }} logo" width="40" height="40" class="site-brand__logo" />
          <span class="site-brand__text">
            <span class="site-brand__name">Incident<span class="brand-spark">GIS</span></span>
            <span class="site-brand__tag">Python &amp; emergency response</span>
          </span>
        </a>

        <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch to dark theme">
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/></svg>
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.4v2.4M12 19.2v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.4 12h2.4M19.2 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/></svg>
        </button>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
          <span class="nav-toggle__bars"><span></span><span></span><span></span></span>
        </button>

        <nav id="primary-nav" class="site-nav" aria-label="Primary">
          <a href="{{ site.url }}/" class="site-nav__link{% if _isHome %} is-active{% endif %}"{% if _isHome %} aria-current="page"{% endif %}>
            <svg class="nav-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11.5 12 4l9 7.5"/><path d="M5 10v10h14V10"/></svg>
            <span>Home</span>
          </a>
          {% for section in site.sections %}
            {% set _isActive = _path == "/" + section.slug + "/" or (_path.startsWith and _path.startsWith("/" + section.slug + "/")) %}
            <a href="{{ site.url }}/{{ section.slug }}/" class="site-nav__link{% if _isActive %} is-active{% endif %}"{% if _isActive %} aria-current="true"{% endif %}>
              {% include "partials/icon-" + section.icon + ".njk" ignore missing %}
              <span>{{ section.short }}</span>
            </a>
          {% endfor %}
        </nav>
      </div>
    </header>

    <main id="main" class="site-main">
      {{ content | safe }}
    </main>

    <footer class="site-footer" role="contentinfo">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <img src="/assets/icons/logo.svg" alt="" width="32" height="32" />
          <div>
            <strong>{{ site.name }}</strong>
            <p>{{ site.title }}</p>
          </div>
        </div>
        <nav class="site-footer__nav" aria-label="Footer">
          <h2>Sections</h2>
          <ul>
            <li><a href="{{ site.url }}/">Home</a></li>
            {% for section in site.sections %}
              <li><a href="{{ site.url }}/{{ section.slug }}/">{{ section.title }}</a></li>
            {% endfor %}
            <li><a href="{{ site.url }}/sitemap.xml">Sitemap</a></li>
          </ul>
        </nav>
        <div class="site-footer__meta">
          <p>Field-tested Python patterns for emergency operations.</p>
          <p class="site-footer__social">
            <a href="https://github.com/incidentgis" class="site-footer__social-link" aria-label="Incident GIS on GitHub" rel="noopener">
              <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"/></svg>
              <span>GitHub</span>
            </a>
          </p>
          <p class="muted">&copy; {{ site.name }}</p>
        </div>
      </div>
    </footer>

    <script src="/assets/js/main.js?v={{ assets.main }}" defer></script>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
